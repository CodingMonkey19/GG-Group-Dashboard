{
  "name": "@gg/spend-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GG Spend Dashboard backend — consolidation pipeline + read-only HTTP API.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "consolidate": "tsx src/pipeline/consolidate.ts",
    "serve": "tsx src/api/server.ts",
    "dev": "tsx watch src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1"
  }
}
